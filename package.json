{
  "name": "directoros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "npx --yes supabase@2.109.1 start",
    "db:stop": "npx --yes supabase@2.109.1 stop",
    "db:reset": "npx --yes supabase@2.109.1 db reset",
    "db:migration:new": "npx --yes supabase@2.109.1 migration new",
    "db:types": "npx --yes supabase@2.109.1 gen types --local --schema public > lib/supabase/database.types.ts",
    "db:validate": "npm run db:reset && npm run db:types && git diff --exit-code -- lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
